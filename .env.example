# Copy to .env.local for development. Set the same keys in Vercel for production.

# --- Site ---------------------------------------------------------------
# Canonical origin. Omit in production (defaults to https://chromesphynx.com).
# Set for staging/preview, e.g. https://chrome-sphynx-web.vercel.app
# NEXT_PUBLIC_SITE_URL=
# CS_SUPPORT_EMAIL=support@chromesphynx.com

# --- Licensing ----------------------------------------------------------
# Ed25519 private key (64 hex chars) that signs trial and full licenses.
# Generate with: npm run license -- keygen
# The matching public key is compiled into the plugins. NEVER commit this.
CS_LICENSE_PRIVATE_KEY=

# --- Email (Resend) -----------------------------------------------------
# Without RESEND_API_KEY the trial endpoint returns the license in the
# response body instead of emailing it — fine for development.
# RESEND_API_KEY=
# CS_LICENSE_EMAIL_FROM=Chrome Sphynx Audio <support@chromesphynx.com>

# --- Database -----------------------------------------------------------
# REQUIRED in production. Without it the ephemeral file store is used and
# every trial and order is lost on redeploy. Use your provider's POOLED
# connection string (pgbouncer) — serverless opens many short connections.
# Apply the schema with: npm run db:migrate
# DATABASE_URL=postgres://user:pass@host/db
# DATABASE_SSL=disable   # only for a local Postgres without TLS

# --- Paddle (merchant of record) ----------------------------------------
# Secret for the notification destination that points at
# /api/webhooks/paddle. Each destination has its own key (pdl_ntfset_...).
# PADDLE_WEBHOOK_SECRET_KEY=
# API key, used to look up a customer's email when the webhook payload
# carries only customer_id.
# PADDLE_API_KEY=
# PADDLE_API_BASE=https://sandbox-api.paddle.com   # sandbox only
# Maps Paddle price/product ids to our product ids. Fill in after creating
# the catalog in the Paddle dashboard.
# CS_PADDLE_PRODUCT_MAP={"pri_xxx":"block-rotator","pri_yyy":"poltergeist"}
