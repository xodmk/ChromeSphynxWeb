# Copy to .env.local for development. Set the same keys in Vercel for production.

# --- Site ---------------------------------------------------------------
# Canonical origin. Omit in production (defaults to https://chromesphynx.com).
# Set for staging/preview, e.g. https://chrome-sphynx-web.vercel.app
# NEXT_PUBLIC_SITE_URL=
# CS_SUPPORT_EMAIL=support@chromesphynx.com

# --- Licensing ----------------------------------------------------------
# Ed25519 private key (64 hex chars) that signs trial and full licenses.
# Generate with: npm run license -- keygen
# The matching public key is compiled into the plugins. NEVER commit this.
CS_LICENSE_PRIVATE_KEY=

# --- Email (Resend) -----------------------------------------------------
# Without RESEND_API_KEY the trial endpoint returns the license in the
# response body instead of emailing it — fine for development.
# RESEND_API_KEY=
# CS_LICENSE_EMAIL_FROM=Chrome Sphynx Audio <support@chromesphynx.com>
